{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optimind Approval Gates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gameId",
    "concept",
    "artDirection"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "gameId": {
      "type": "string",
      "minLength": 3
    },
    "concept": {
      "$ref": "#/$defs/gate"
    },
    "artDirection": {
      "$ref": "#/$defs/gate"
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "revision",
        "approvedAt",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
