{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optimind Game Specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "revision",
    "platform",
    "gameplay",
    "artDirection",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,49}$"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "pitch": {
      "type": "string"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "orientation",
        "input",
        "locales"
      ],
      "properties": {
        "target": {
          "const": "web"
        },
        "orientation": {
          "const": "portrait"
        },
        "input": {
          "enum": [
            "tap",
            "tap-drag",
            "keyboard-and-tap"
          ]
        },
        "locales": {
          "type": "array",
          "items": {
            "enum": [
              "id",
              "en"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genre",
        "goal",
        "coreLoop",
        "winCondition",
        "loseCondition",
        "resetBehavior",
        "timer"
      ],
      "properties": {
        "genre": {
          "type": "string",
          "minLength": 2
        },
        "goal": {
          "type": "string",
          "minLength": 5
        },
        "coreLoop": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "winCondition": {
          "type": "string",
          "minLength": 3
        },
        "loseCondition": {
          "type": "string",
          "minLength": 3
        },
        "resetBehavior": {
          "type": "string",
          "minLength": 3
        },
        "timer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "pauseDuringModal"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7200
            },
            "pauseDuringModal": {
              "type": "boolean"
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "palette",
        "assetStrategy",
        "motion"
      ],
      "properties": {
        "style": {
          "type": "string",
          "minLength": 2
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "minItems": 2
        },
        "assetStrategy": {
          "enum": [
            "ai-generated",
            "user-supplied",
            "hybrid"
          ]
        },
        "motion": {
          "type": "string",
          "minLength": 2
        },
        "referenceNotes": {
          "type": "string"
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      },
      "minItems": 2
    }
  }
}
